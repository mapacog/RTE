{
  "name": "rte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "check": "npm run check:repo && npm test && npm run build",
    "check:repo": "node scripts/checkRepository.mjs",
    "prepare:tables": "python scripts/prepareReportTables.py",
    "prepare:counters": "python scripts/prepareCounterVolumes.py",
    "prepare:transit": "python scripts/prepareTransitGroups.py",
    "prepare:maps": "node scripts/prepareMapData.mjs",
    "prepare:locales": "node scripts/prepareLocaleCatalog.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.2.0",
    "react-test-renderer": "^18.3.1",
    "vite": "^6.0.7"
  }
}
